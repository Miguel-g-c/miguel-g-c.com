---
import TechStack from "./TechStack.astro";

interface Props {
  title: string;
  description: string;
  link: string;
  technologies: string[];
}

const { title, description, link, technologies } = Astro.props;
---

<a
  href={link}
  target="_blank"
  rel="noopener"
  class="group flex flex-wrap gap-x-7 gap-y-5 border-t border-line py-7 text-fg no-underline print:break-inside-avoid"
>
  <div class="flex h-[70px] w-28 shrink-0 items-center justify-center rounded-[10px] border border-line bg-bg transition-[color,border-color,background-color] duration-200 group-hover:border-accent group-hover:bg-accent-soft group-hover:text-accent print:hidden">
    <slot />
  </div>
  <div class="min-w-0 flex-[1_1_360px]">
    <div class="flex items-baseline justify-between gap-4">
      <h3 class="text-lg font-semibold transition-colors duration-200 group-hover:text-accent">
        {title}
      </h3>
      <span
        aria-hidden="true"
        class="font-mono text-sm text-faint transition-[transform,color] duration-200 group-hover:translate-x-[3px] group-hover:-translate-y-[3px] group-hover:text-accent print:hidden"
      >
        ↗
      </span>
    </div>
    <p class="mt-1.5 text-[15px] text-muted">{description}</p>
    <TechStack technologies={technologies} />
  </div>
</a>
