---
interface Tech {
  name: string;
  icon: (_props: Record<string, any>) => any;
}

interface Props {
  size: number;
  technologies: Tech[];
}

const { size, technologies } = Astro.props;
const rems = `${size / 4}rem`;
---

<div
  class="mt-4 inline-flex flex-row items-center gap-3 rounded-full bg-sky-700/10 p-2 text-slate-700 dark:bg-sky-300/10 dark:text-white"
>
  {
    technologies.map((tech) => (
      <div title={tech.name}>
        <tech.icon class="tech-icon" />
      </div>
    ))
  }
</div>

<style define:vars={{ rems }}>
  .tech-icon {
    width: var(--rems);
    height: var(--rems);
  }
</style>
