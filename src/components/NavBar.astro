---
import NavLink from "./NavLink.astro";

interface Props {
  direction?: "row" | "column";
  class?: string;
}

const { direction = "row", class: className = "" } = Astro.props;
const column = direction === "column";
const linkClass = column
  ? "w-full rounded-lg px-3 after:hidden hover:bg-accent-soft hover:text-accent"
  : "";
---

<nav
  aria-label="Main"
  class:list={[
    "flex",
    column ? "flex-col items-stretch" : "items-center gap-5",
    className,
  ]}
>
  <NavLink href="#experience" class={linkClass}>
    experience
  </NavLink>
  <NavLink href="#projects" class={linkClass}>
    projects
  </NavLink>
  <NavLink href="#contact" class={linkClass}>
    contact
  </NavLink>
</nav>
