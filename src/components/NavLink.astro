---
interface Props {
  id: string;
  href: string;
  class?: string;
}

const { id, href, class: className } = Astro.props;
---

<a
  id={id}
  class={`block px-2 py-1 text-sm tracking-tighter transition-colors duration-[260ms] ease-out sm:px-3 sm:text-base ${className} hover:text-sky-700 dark:hover:text-sky-300`}
  href={href}
>
  <slot />
</a>
