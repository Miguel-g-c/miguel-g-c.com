---
interface Props {
  id: string;
  href: string;
  class?: string;
}

const { id, href, class: className } = Astro.props;
---

<a
  id={id}
  class={`block py-1 px-3 tracking-tighter transition-colors duration-[260ms] ease-out ${className} hover:text-sky-700 dark:hover:text-sky-300`}
  href={href}
>
  <slot />
</a>
