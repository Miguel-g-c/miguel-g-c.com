---
import NavBar from "./NavBar.astro";

const currentYear = new Date().getFullYear();
---

<footer class="mt-20 sm:px-8 print:hidden">
  <div
    class="mx-auto max-w-4xl border-t border-sky-700/10 pb-16 pt-10 lg:px-8 dark:border-blue-300/10"
  >
    <div class="flex flex-col gap-2">
      <div class="flex flex-col gap-6 justify-between items-center sm:flex-row">
        <NavBar
          class="text-sm font-thin text-sky-800/45 dark:text-blue-300/30"
        />
        <p class="text-sm text-sky-800/45 dark:text-blue-300/30">
          © {currentYear} Miguel García Casas
        </p>
      </div>
      <div class="flex items-end self-center sm:self-end">
        <a
          class="mx-auto my-[10px] text-sm text-sky-800/45 hover:text-sky-700/60 dark:text-blue-300/30 dark:hover:text-sky-300/35"
          href="mailto:miguel.g.c.505@gmail.com"
        >
          miguel.g.c.505@gmail.com
        </a>
      </div>
    </div>
  </div>
</footer>
