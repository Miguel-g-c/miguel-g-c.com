---
import Avatar from "../Avatar.astro";
import GitHub from "../Icons/GitHub.astro";
import LinkedIn from "../Icons/LinkedIn.astro";
import Mail from "../Icons/Mail.astro";
import KeyWord from "../KeyWord.astro";
import StatusBadge from "../StatusBadge.astro";

const currentYear = new Date().getFullYear();
const yearsOfExperience = currentYear - 2016;
const githubUrl = "https://github.com/Miguel-g-c";
const linkedInUrl =
  "https://www.linkedin.com/in/miguel-garcía-casas-b0b683145/";
const email = "miguel.g.c.505@gmail.com";
---

<section id="about" data-section="about">
  <div
    class="flex flex-col gap-3 items-center mx-auto mt-20 lg:mt-32 print:mt-12"
  >
    <Avatar />
    <nav class="flex flex-row gap-2 print:hidden">
      <a href={githubUrl} target="_blank" aria-label="Visit my GitHub profile">
        <GitHub
          class="social-icon size-8 transition-colors duration-[260ms] ease-out hover:text-sky-600 dark:hover:text-sky-300"
        />
      </a>
      <a
        href={linkedInUrl}
        target="_blank"
        aria-label="Connect with me on LinkedIn"
      >
        <LinkedIn
          class="social-icon size-8 transition-colors duration-[260ms] ease-out hover:text-sky-600 dark:hover:text-sky-300"
        />
      </a>
      <a href={`mailto:${email}`} target="_blank" aria-label="Email me">
        <Mail
          class="social-icon size-8 transition-colors duration-[260ms] ease-out hover:text-sky-600 dark:hover:text-sky-300"
        />
      </a>
    </nav>
    <div class="flex flex-col gap-4 mt-12 mb-2 max-w-[75ch]">
      <div class="flex flex-row gap-4">
        <h1 class="text-4xl font-bold tracking-tighter sm:text-5xl">
          Hey, I'm Miguel
        </h1>
        <StatusBadge>Open for consulting</StatusBadge>
      </div>

      <div class="space-y-2">
        <h2 class="text-lg text-slate-700 sm:text-xl dark:text-gray-200">
          <KeyWord>Engineer</KeyWord> with over {yearsOfExperience} years of experience.
          <KeyWord>PhD</KeyWord> in Industrial Technologies, specializing in <KeyWord
          >
            life cycle assessment
          </KeyWord>, <KeyWord>calculation engines</KeyWord>
          and <KeyWord>agentic AI systems</KeyWord>.
          <span class="text-lg text-sky-700 sm:text-xl dark:text-sky-200">
            Building software for a more sustainable future.
          </span>
        </h2>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes highlight {
    0%,
    100% {
      stroke: currentColor;
    }
    20%,
    80% {
      stroke: rgb(125 211 252);
    }
  }

  .highlight-icon {
    animation: highlight 500ms ease-in-out;
  }
</style>
