---
import Avatar from "../Avatar.astro";
import GitHub from "../Icons/GitHub.astro";
import LinkedIn from "../Icons/LinkedIn.astro";
import Mail from "../Icons/Mail.astro";
import KeyWord from "../KeyWord.astro";

const currentYear = new Date().getFullYear();
const yearsOfExperience = currentYear - 2016;
const githubUrl = "https://github.com/Miguel-g-c";
const linkedInUrl =
  "https://www.linkedin.com/in/miguel-garcía-casas-b0b683145/";
const email = "miguel.g.c.505@gmail.com";
---

<section
  id="top"
  aria-labelledby="hero-title"
  class="flex flex-wrap items-start gap-x-12 gap-y-8 pt-16 pb-4 lg:pt-24 print:pt-6 print:pb-0"
>
  <Avatar />
  <div class="min-w-0 flex-[1_1_420px]">
    <p class="mb-5 flex items-center gap-2.5 font-mono text-[13px] text-muted print:hidden">
      <span
        class="status-dot inline-block size-2 rounded-full bg-accent"
        aria-hidden="true"
      ></span>
      <span>open for consulting</span>
    </p>
    <h1
      id="hero-title"
      class="text-5xl leading-[1.02] font-bold tracking-[-0.03em] sm:text-[56px] print:text-4xl"
    >
      Hey, I'm Miguel.
    </h1>
    <p class="mt-4 font-mono text-sm text-accent">
      sustainability × backend × agents
    </p>
    <p class="mt-6 max-w-[560px] text-lg text-muted">
      Engineer with over {yearsOfExperience} years of experience and a PhD in
      Industrial Technologies. I build <KeyWord>calculation engines</KeyWord>,{" "}
      <KeyWord>life cycle assessment</KeyWord> tooling and{" "}
      <KeyWord>agentic systems</KeyWord>, so that carbon numbers are accurate,
      explainable and useful.
    </p>
    <div class="mt-7 flex flex-wrap gap-2.5 print:hidden">
      <a class="icon-btn" href={githubUrl} aria-label="GitHub" title="GitHub">
        <GitHub class="size-[18px]" />
      </a>
      <a
        class="icon-btn"
        href={linkedInUrl}
        aria-label="LinkedIn"
        title="LinkedIn"
      >
        <LinkedIn class="size-[18px]" />
      </a>
      <a
        class="icon-btn"
        href={`mailto:${email}`}
        aria-label="Email"
        title="Email"
      >
        <Mail class="size-[18px]" />
      </a>
    </div>
  </div>
</section>
