---
import ExperienceItem from "../ExperienceItem.astro";
import SectionTitle from "../SectionTitle.astro";

const experiences = [
  {
    title: "Senior Engineer",
    company: "Normative",
    date: "2022 — now",
    description:
      "Engineering data pipelines and calculation engines, making carbon data accessible and understandable for all.",
    technologies: [
      "python",
      "fastapi",
      "typescript",
      "nestjs",
      "sqlite",
      "postgresql",
      "mongodb",
    ],
  },
  {
    title: "Engineer",
    company: "GreenDelta",
    date: "2021 — 2022",
    description:
      "Crafting apps and data analysis tools to drive sustainable innovation based on life cycle methodologies.",
    technologies: [
      "java",
      "python",
      "fastapi",
      "typescript",
      "react",
      "postgresql",
      "docker",
    ],
  },
  {
    title: "Industrial PhD",
    company: "Contactica + IMDEA Energy",
    date: "2018 — 2021",
    description:
      "Developing an eco-design tool to optimise industrial processes with sustainability at its core.",
    technologies: ["python", "javascript", "sqlite"],
  },
];
---

<section id="experience" aria-labelledby="experience-title" class="numbered">
  <SectionTitle id="experience-title">experience</SectionTitle>
  <div class="border-b border-line">
    {experiences.map((exp) => (
      <ExperienceItem {...exp} />
    ))}
  </div>
</section>
