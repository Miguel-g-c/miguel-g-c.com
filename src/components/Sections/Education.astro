---
import SectionTitle from "../SectionTitle.astro";

const education = [
  {
    degree: "PhD in Industrial Technologies",
    institution: "Universidad Rey Juan Carlos",
    date: "2018 — 2023",
    highlights: ["cum laude", "industrial phd"],
  },
  {
    degree: "Master in Energy and Fuels for the Future",
    institution: "Universidad Autónoma de Madrid",
    date: "2016 — 2017",
    highlights: [],
  },
  {
    degree: "Bachelor's Degree in Energy Engineering",
    institution: "Universidad Politécnica de Madrid",
    date: "2010 — 2015",
    highlights: ["bsc thesis with honorable mention"],
  },
];
---

<section
  id="education"
  aria-labelledby="education-title"
  class="numbered hidden print:block print:break-inside-avoid"
>
  <SectionTitle id="education-title">education</SectionTitle>
  <div class="border-b border-line">
    {education.map((entry) => (
      <article class="flex flex-wrap gap-x-6 gap-y-2 border-t border-line py-5">
        <p class="w-[120px] shrink-0 pt-1 font-mono text-[13px] text-faint">
          <time>{entry.date}</time>
        </p>
        <div class="min-w-0 flex-[1_1_320px]">
          <h3 class="text-[17px] font-semibold">
            {entry.institution}{" "}
            <span class="font-normal text-muted">· {entry.degree}</span>
          </h3>
          {entry.highlights.length > 0 && (
            <ul class="mt-3 flex flex-wrap gap-1.5">
              {entry.highlights.map((highlight) => (
                <li class="chip">{highlight}</li>
              ))}
            </ul>
          )}
        </div>
      </article>
    ))}
  </div>
</section>
