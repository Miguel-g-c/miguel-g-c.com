---
import Agents from "../Illustrations/Agents.astro";
import CalcApi from "../Illustrations/CalcApi.astro";
import Eco2des from "../Illustrations/Eco2des.astro";
import Infinite from "../Illustrations/Infinite.astro";
import OpenLca from "../Illustrations/OpenLca.astro";
import ProjectCard from "../ProjectCard.astro";
import SectionTitle from "../SectionTitle.astro";

const projects = [
  {
    title: "Normative's calc-api",
    description:
      "A streamlined carbon accounting engine that calculates the carbon footprint of businesses or products. As the core of Normative's services, it gathers and analyses operational data, providing accurate emission insights.",
    link: "https://normative.io/",
    illustration: CalcApi,
    technologies: ["python", "fastapi", "sqlite", "postgresql"],
  },
  {
    title: "AI for carbon accounting",
    description:
      "Assistants and agentic workflows for carbon accounting: chat agents connected to multiple MCPs for emissions data, calculation-trace explanations for auditors, RAG over methodology docs, and workflows that select emission factors automatically.",
    link: "https://normative.io/",
    illustration: Agents,
    technologies: ["python", "fastapi", "pydanticai", "sqlite", "postgresql"],
  },
  {
    title: "openLCA ecosystem",
    description:
      "openLCA is one of the world's leading open-source platforms for life cycle assessment. Its ecosystem extends into onlineLCA, enabling scalable, web-based sustainability calculations for enterprises, including integrations with ABB and Mercedes.",
    link: "https://www.openlca.org/",
    illustration: OpenLca,
    technologies: ["java", "python", "docker"],
  },
  {
    title: "Infinite's LCA plugin",
    description:
      "INFINITE brings a digital environment for decision-making to building retrofitting. Integrated into a BIM platform, the LCA plugin combines technical and sustainability data to support sustainable design at every stage of a renovation.",
    link: "https://build-up.ec.europa.eu/en/news-and-events/news/new-bim-platform-better-building-data-management",
    illustration: Infinite,
    technologies: ["python", "fastapi", "postgresql", "react"],
  },
  {
    title: "eco2des",
    description:
      "A Python framework for optimising industrial processes with sustainability at the core. It documents life cycle inventories, assesses environmental impacts and couples physicochemical models with multi-objective optimisation.",
    link: "https://doi.org/10.1016/j.compchemeng.2021.107624",
    illustration: Eco2des,
    technologies: ["python"],
  },
];

const visibleProjects = projects.slice(0, 4);
const hiddenProjects = projects.slice(4);
---

<section id="projects" aria-labelledby="projects-title" class="numbered">
  <SectionTitle id="projects-title">projects</SectionTitle>
  <div class="border-b border-line">
    {visibleProjects.map(({ illustration: Illustration, ...project }) => (
      <ProjectCard {...project}>
        <Illustration />
      </ProjectCard>
    ))}
    {hiddenProjects.map(({ illustration: Illustration, ...project }) => (
      <div class="project-extra" data-hidden-project>
        <ProjectCard {...project}>
          <Illustration />
        </ProjectCard>
      </div>
    ))}
  </div>
  {hiddenProjects.length > 0 && (
    <div class="mt-6 flex justify-center print:hidden" data-projects-toggle>
      <button
        type="button"
        data-show-more-projects
        class="btn"
        aria-expanded="false"
      >
        <span>show more projects</span>
        <span aria-hidden="true">+</span>
      </button>
    </div>
  )}
</section>

<script>
  const button = document.querySelector("[data-show-more-projects]");
  const hidden = document.querySelectorAll("[data-hidden-project]");
  const toggle = document.querySelector("[data-projects-toggle]");

  button?.addEventListener(
    "click",
    () => {
      hidden.forEach((project) => {
        project.setAttribute("data-revealing", "true");
        project.getBoundingClientRect();
        project.setAttribute("data-expanded", "true");
      });
      button.setAttribute("aria-expanded", "true");
      toggle?.classList.add("projects-toggle-hidden");
    },
    { once: true },
  );
</script>

<style is:global>
  .project-extra {
    display: none;
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    transform: translateY(0.75rem);
    transition:
      max-height 500ms ease,
      opacity 350ms ease,
      transform 500ms ease;
  }

  .project-extra[data-revealing="true"],
  .project-extra[data-expanded="true"] {
    display: block;
  }

  .project-extra[data-expanded="true"] {
    max-height: 900px;
    opacity: 1;
    transform: translateY(0);
  }

  .projects-toggle-hidden {
    max-height: 0;
    margin-top: 0;
    overflow: hidden;
    pointer-events: none;
    opacity: 0;
    transition:
      max-height 250ms ease,
      margin-top 250ms ease,
      opacity 250ms ease;
  }

  @media print {
    .project-extra {
      display: block;
      max-height: none;
      overflow: visible;
      opacity: 1;
      transform: none;
    }
  }
</style>
