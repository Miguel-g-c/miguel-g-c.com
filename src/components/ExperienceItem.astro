---
import TechStack from "./TechStack.astro";

interface Props {
  title: string;
  company: string;
  date: string;
  description: string;
  technologies: string[];
}

const { title, company, date, description, technologies } = Astro.props;
---

<article class="flex flex-wrap gap-x-6 gap-y-2 border-t border-line py-6 print:break-inside-avoid">
  <p class="w-[120px] shrink-0 pt-1 font-mono text-[13px] text-faint">
    <time>{date}</time>
  </p>
  <div class="min-w-0 flex-[1_1_320px]">
    <h3 class="text-[17px] font-semibold">
      {company} <span class="font-normal text-muted">· {title}</span>
    </h3>
    <p class="mt-1.5 text-[15px] text-muted">{description}</p>
    <TechStack technologies={technologies} />
  </div>
</article>
