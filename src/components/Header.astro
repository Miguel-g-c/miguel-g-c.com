---
import DownloadButton from "./DownloadButton.astro";
import NavBar from "./NavBar.astro";
import ThemeToggle from "./ThemeToggle.astro";
---

<header class="sticky top-0 z-50 bg-bg/80 backdrop-blur-md print:hidden">
  <div class="mx-auto flex w-full max-w-[808px] flex-wrap items-center justify-between gap-x-6 gap-y-2 px-6 py-3">
    <a href="#top" class="font-mono text-sm font-medium no-underline">
      miguel-g-c<span class="text-faint">.com</span>
    </a>
    <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
      <NavBar />
      <div class="flex items-center gap-2">
        <DownloadButton />
        <ThemeToggle />
      </div>
    </div>
  </div>
</header>
