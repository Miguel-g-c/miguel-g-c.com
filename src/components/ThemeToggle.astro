<button
  type="button"
  data-theme-toggle
  class="group relative inline-flex size-9 items-center justify-center overflow-hidden rounded-full border border-sky-700/20 bg-white/70 text-slate-700 shadow-sm shadow-sky-900/5 backdrop-blur-xl transition-all duration-500 ease-out hover:border-sky-500/50 hover:bg-sky-50 hover:text-sky-700 dark:border-blue-300/30 dark:bg-black/60 dark:text-blue-100/80 dark:hover:border-sky-300 dark:hover:bg-slate-800/80 dark:hover:text-sky-200/90"
  aria-label="Switch to light theme"
  title="Toggle theme"
>
  <svg
    class="absolute size-4 transition-all duration-500 ease-out dark:rotate-0 dark:scale-100 dark:opacity-100 -rotate-90 scale-75 opacity-0"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M12 3a6 6 0 0 0 9 7.3A9 9 0 1 1 12 3Z"></path>
  </svg>
  <svg
    class="absolute size-4 rotate-0 scale-100 opacity-100 transition-all duration-500 ease-out dark:rotate-90 dark:scale-75 dark:opacity-0"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2"></path>
    <path d="M12 20v2"></path>
    <path d="m4.93 4.93 1.41 1.41"></path>
    <path d="m17.66 17.66 1.41 1.41"></path>
    <path d="M2 12h2"></path>
    <path d="M20 12h2"></path>
    <path d="m6.34 17.66-1.41 1.41"></path>
    <path d="m19.07 4.93-1.41 1.41"></path>
  </svg>
</button>

<script>
  const updateThemeToggle = (theme: string) => {
    const button = document.querySelector("[data-theme-toggle]");

    if (!button) return;

    const label =
      theme === "dark" ? "Switch to light theme" : "Switch to dark theme";

    button.setAttribute("aria-label", label);
    button.setAttribute("title", label);
  };

  let hasManualThemeOverride = false;

  const applyTheme = (theme: string) => {
    const root = document.documentElement;
    const isDark = theme === "dark";

    root.classList.add("theme-transition");
    root.classList.toggle("dark", isDark);
    root.dataset.theme = theme;
    root.style.colorScheme = theme;

    updateThemeToggle(theme);

    window.setTimeout(() => {
      root.classList.remove("theme-transition");
    }, 600);
  };

  const systemThemeQuery = window.matchMedia("(prefers-color-scheme: dark)");

  systemThemeQuery.addEventListener("change", (event) => {
    if (hasManualThemeOverride) return;

    applyTheme(event.matches ? "dark" : "light");
  });

  const attachThemeToggle = () => {
    const button = document.querySelector("[data-theme-toggle]");
    const theme = document.documentElement.classList.contains("dark")
      ? "dark"
      : "light";

    updateThemeToggle(theme);

    if (!button) return;
    if (button.hasAttribute("data-theme-toggle-ready")) return;

    button.setAttribute("data-theme-toggle-ready", "true");

    button.addEventListener("click", () => {
      const nextTheme = document.documentElement.classList.contains("dark")
        ? "light"
        : "dark";

      hasManualThemeOverride = true;
      applyTheme(nextTheme);
    });
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", attachThemeToggle);
  } else {
    attachThemeToggle();
  }

  document.addEventListener("astro:after-swap", attachThemeToggle);
</script>
