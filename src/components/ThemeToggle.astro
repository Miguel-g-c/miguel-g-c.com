<button
  type="button"
  data-theme-toggle
  class="btn relative w-11 px-0"
  aria-label="Switch to dark theme"
  title="Switch to dark theme"
>
  <svg
    class="absolute size-4 -rotate-90 scale-75 opacity-0 transition-[transform,opacity] duration-500 ease-out dark:rotate-0 dark:scale-100 dark:opacity-100"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M6.3 17.7l-1.4 1.4M19.1 4.9l-1.4 1.4"></path>
  </svg>
  <svg
    class="absolute size-4 rotate-0 scale-100 opacity-100 transition-[transform,opacity] duration-500 ease-out dark:rotate-90 dark:scale-75 dark:opacity-0"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M12 3a6 6 0 0 0 9 7.3A9 9 0 1 1 12 3Z"></path>
  </svg>
</button>

<script>
  const root = document.documentElement;
  const button = document.querySelector<HTMLButtonElement>(
    "[data-theme-toggle]",
  );

  const currentTheme = () =>
    root.classList.contains("dark") ? "dark" : "light";

  const updateLabel = () => {
    if (!button) return;
    const label =
      currentTheme() === "dark"
        ? "Switch to light theme"
        : "Switch to dark theme";
    button.setAttribute("aria-label", label);
    button.setAttribute("title", label);
  };

  const applyTheme = (theme: "light" | "dark", persist: boolean) => {
    root.classList.add("theme-transition");
    root.classList.toggle("dark", theme === "dark");
    root.dataset.theme = theme;
    updateLabel();
    if (persist) {
      try {
        localStorage.setItem("theme", theme);
      } catch {}
    }
    window.setTimeout(() => root.classList.remove("theme-transition"), 600);
  };

  const systemTheme = window.matchMedia("(prefers-color-scheme: dark)");
  systemTheme.addEventListener("change", (event) => {
    let saved: string | null = null;
    try {
      saved = localStorage.getItem("theme");
    } catch {}
    if (saved === "light" || saved === "dark") return;
    applyTheme(event.matches ? "dark" : "light", false);
  });

  updateLabel();
  button?.addEventListener("click", () => {
    applyTheme(currentTheme() === "dark" ? "light" : "dark", true);
  });
</script>
